# Copy to .env and replace every placeholder before starting the stack.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=production
DEPLOYMENT_MODE=self_hosted
SECRET_KEY=replace-with-a-unique-random-secret-at-least-48-characters
POSTGRES_DB=sentinelai
POSTGRES_USER=sentinelai
POSTGRES_PASSWORD=replace-with-a-strong-unique-postgres-password
ZAP_API_KEY=replace-with-a-separate-strong-random-zap-key
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
APP_ORIGIN=http://localhost:3000
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
ALLOW_PUBLIC_SIGNUP=false
ALLOW_HTTP_TARGETS=true
# Keep false unless this self-hosted installation is isolated and the operator understands the risk.
ALLOW_PRIVATE_TARGETS=false
ENABLE_ZAP=true
SCAN_MAX_PAGES=40
SCAN_TIMEOUT_SECONDS=600
SCAN_MAX_CONCURRENCY=2
AI_BASE_URL=
# For optional local Ollama profile, set AI_BASE_URL=http://ollama:11434/v1
AI_API_KEY=
AI_MODEL=Qwen3:1.7B
